meta {
  name: progress
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/progress
  body: none
  auth: none
}

docs {
  Poll the progress of the current process.
  Returns `stage` (`running stage label` | `done` | `cancelled` | `error`), `percentage`,
  `rows_total`, and `rows_processed`.
  Returns 404 if no process has been submitted yet.
}
