meta {
  name: stream
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/progress/stream?job_id
  body: none
  auth: none
}

headers {
  X-M2M-Key: {{m2mKey}}
}

params:query {
  job_id:
}

docs {
  Stream the progress of the process submitted under `job_id` as Server-Sent Events.
  Each `data:` event is a JSON snapshot with `stage`, `percentage`, `rows_total`,
  `rows_processed`, and `done` (`true` once the process has completed). Events are
  only emitted when the snapshot changes; the stream closes after the `done` event.
  Returns 404 if no process has been submitted under this `job_id`.
}
