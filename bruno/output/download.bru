meta {
  name: download
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/download/{{outputFile}}
  body: none
  auth: none
}

docs {
  Download a processed output file.
  `outputFile` is set automatically after a successful result request.
  Replace `{{outputFile}}` with any filename from the result response (datakey, log) to download those instead.
}
