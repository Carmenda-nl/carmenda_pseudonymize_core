meta {
  name: cancel
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/process
  body: none
  auth: none
}

headers {
  X-M2M-Key: {{m2mKey}}
}

docs {
  Cancel the running process.
  The cancellation is picked up at the next checkpoint in the processing thread.

  Returns 202 `{status: 'cancelling'}` on success.
  Returns 404 if no process is running.
}
