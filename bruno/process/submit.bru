meta {
  name: submit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/process
  body: formUrlEncoded
  auth: none
}

headers {
  X-M2M-Key: {{m2mKey}}
}

body:form-urlencoded {
  file: dummy_input.csv
  cols: report=rapport
  job_id: 
  datakey: 
}

docs {
  Submit a pseudonymization job for a file already on the shared volume.
  
  Required:
  - `file`: path to the report file (CSV or Excel); must resolve inside `input_folder`
  - `cols`: comma-separated column mappings, at least one `report` key required
    Example: `clientname=Patient, report=Report`
  - `job_id`: gateway job identifier; the engine writes its output into
    `output_folder/{job_id}` and tags the run so progress/result polls can be matched to it
  
  Optional:
  - `datakey`: path to a datakey file for consistent pseudonymization across sessions
  
  Returns 202 `{status: 'accepted'}` on success.
  Returns 400 if `file` resolves outside `input_folder`, or `job_id` escapes `output_folder`.
  Returns 404 if `file_path` does not exist.
  Returns 409 if a process is already running.
}
